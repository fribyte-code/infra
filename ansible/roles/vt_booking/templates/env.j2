# {{ ansible_managed }}
# Settings for compose.prod.yaml. See .env.example and docs/DEPLOYMENT.md in the app repository.

DB_PASSWORD={{ vt_booking_db_password }}

# Only the nginx on this host connects to the app
HTTP_BIND=127.0.0.1
HTTP_PORT={{ vt_booking_http_port }}

# The host nginx, as the app's nginx sees it: the gateway of the compose network
TRUSTED_PROXY={{ vt_booking_trusted_proxy }}
REAL_IP_HEADER=X-Forwarded-For

IMAGE_TAG={{ vt_booking_image_tag }}