# Mounted by compose.prod.yaml. At start, the Nginx image fills in the variables (from .env) and
# writes the result to /etc/nginx/conf.d/real-ip.conf. Requests from TRUSTED_PROXY, the reverse
# proxy in front of Nginx, carry the client address in REAL_IP_HEADER; from anywhere else the
# header is ignored. The default, 127.0.0.1, trusts no proxy.
set_real_ip_from ${TRUSTED_PROXY};
real_ip_header ${REAL_IP_HEADER};
real_ip_recursive on;
